APP_NAME=ARTISAN Backend
ENVIRONMENT=development
DATABASE_URL=sqlite:///./artisan.db
AUTO_CREATE_TABLES=true
STORAGE_DIR=storage
MAX_UPLOAD_MB=15

# Optional hosted AI service. It is never required for local image processing,
# local ASR, local translation, or benchmark-based pricing.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TRANSCRIPTION_MODEL=whisper-1
OPENAI_BASE_URL=

# Real local/open-source model settings.
ENABLE_LOCAL_WHISPER=false
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
ENABLE_LOCAL_TRANSLATION=false
TRANSLATION_MODEL=facebook/nllb-200-distilled-600M
TRANSLATION_DEVICE=cpu

# Optional local multimodal model through Ollama.
ENABLE_OLLAMA=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b

# Real image pipeline. rembg is optional; OpenCV/Pillow remain available.
IMAGE_BACKGROUND_METHOD=auto
ENABLE_REMBG=false

# Only enable for explicitly labelled tests/demos. Never use as live AI.
ALLOW_DEMO_AI_OVERRIDES=false

# Optional Neo4j Community graph layer.
GRAPH_ENABLED=false
GRAPH_SYNC_ON_WRITE=true
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=artisan_graph
NEO4J_DATABASE=neo4j

MARKET_BENCHMARK_PATH=data/market_benchmarks.json
